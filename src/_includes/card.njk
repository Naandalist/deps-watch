<article class="pkg">
  <h3 class="package"><a href="{{ item.action_url }}">{{ item.package }}</a></h3>
  <p class="summary">{{ item.summary }}</p>
  <p class="meta">
    <span>{{ item.severity }}</span>
    <span>{{ item.status | statusLabel }}</span>
    <span>{{ item.id }}</span>
    {% if item.version_note %}<span>{{ item.version_note }}</span>{% endif %}
    {% if item.weekly_downloads %}<span>{{ item.weekly_downloads | formatCount }} weekly downloads</span>{% endif %}
    {% if item.github_stars %}<span>{{ item.github_stars | formatCount }} stars</span>{% endif %}
    {% if item.github_forks %}<span>{{ item.github_forks | formatCount }} forks</span>{% endif %}
    <time datetime="{{ item.date }}">{{ item.date }}</time>
  </p>
</article>
