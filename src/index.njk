---
layout: false
permalink: index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }} — daily JS dependency security board</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
  <div class="npm-stripe" aria-hidden="true"></div>

  <header class="topbar">
    <a class="brand" href="{{ '/' | url }}">deps-watch</a>
    <p class="top-meta">Updated {{ site.updated }}</p>
  </header>

  <main class="page">
    <section class="panel today" aria-labelledby="today-heading">
      <div class="panel-head rule-red">
        <h2 id="today-heading">📅 Today</h2>
      </div>
      {% if brief.headline %}
        <h3 class="brief-title">{{ brief.headline }}</h3>
        {% for paragraph in brief.paragraphs %}
          <p class="brief-copy">{{ paragraph }}</p>
        {% endfor %}
        {% if brief.pick %}
          <div class="brief-pick">
            <p class="brief-pick-label">{{ brief.pick.label }}</p>
            <p class="brief-pick-pkg"><a href="{{ brief.pick.action_url }}">{{ brief.pick.package }}</a> · {{ brief.pick.action_label }}</p>
            <p class="brief-copy">{{ brief.pick.approach }}</p>
          </div>
        {% endif %}
      {% else %}
        <p class="empty">No brief for this update cycle.</p>
      {% endif %}
    </section>

    <section class="panel board" aria-label="Contribution board">
      <div class="column">
        <div class="panel-head rule-red">
          <h2>🚨 Ready to work</h2>
          <span class="count">{{ board.counts.ready }}</span>
        </div>
        {% if board.ready.length %}
          <ul class="pkg-list">
            {% for item in board.ready %}
              <li>{% include "card.njk" %}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="empty">Nothing waiting for a PR.</p>
        {% endif %}
      </div>

      <div class="column">
        <div class="panel-head rule-gold">
          <h2>🔧 In progress</h2>
          <span class="count">{{ board.counts.progress }}</span>
        </div>
        {% if board.progress.length %}
          <ul class="pkg-list">
            {% for item in board.progress %}
              <li>{% include "card.njk" %}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="empty">No open fix PRs on the board.</p>
        {% endif %}
      </div>

      <div class="column">
        <div class="panel-head rule-yellow">
          <h2>✅ Recently resolved</h2>
          <span class="count">{{ board.counts.resolved }}</span>
        </div>
        {% if board.resolved.length %}
          <ul class="pkg-list">
            {% for item in board.resolved %}
              <li>{% include "card.njk" %}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="empty">No recently resolved items.</p>
        {% endif %}
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <p>Download, star, and fork counts are snapshots from the last admin update.</p>
    <p><a href="{{ site.repo }}/blob/main/src/_data/items.yaml">items.yaml</a> · <a href="{{ site.repo }}">source</a></p>
    <p>Created by <a href="https://naandalist.com">Listiananda Apriliawan</a></p>
  </footer>
</body>
</html>
