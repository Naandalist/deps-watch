---
layout: false
permalink: index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }} — daily JS dependency security board</title>
  <meta name="description" content="{{ site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
  <header class="masthead">
    <div class="masthead-left">
      <p class="mark">Daily board</p>
      <h1>{{ site.title }}</h1>
    </div>
    <div class="masthead-right">
      <p class="edition">{{ site.updated }}</p>
      <p class="tagline">{{ site.tagline }}</p>
      <p class="hint">Read-only. Work happens on the linked issue or pull request.</p>
    </div>
  </header>

  <section class="today" aria-labelledby="today-heading">
    <div class="rule-head">
      <h2 id="today-heading">Today</h2>
      <span class="count">{{ board.counts.today }}</span>
    </div>
    {% if board.today.length %}
      <ol class="today-list">
        {% for item in board.today %}
          <li class="today-row severity-{{ item.severity | lower }}">
            <span class="package">{{ item.package }}</span>
            <span class="severity">{{ item.severity }}</span>
            <span class="status">{{ item.status | statusLabel }}</span>
            <span class="summary">{{ item.summary }}</span>
            <a class="action" href="{{ item.action_url }}">Open</a>
          </li>
        {% endfor %}
      </ol>
    {% else %}
      <p class="empty">No status changes in this update cycle.</p>
    {% endif %}
  </section>

  <section class="board" aria-label="Contribution board">
    <div class="column">
      <div class="rule-head">
        <h2>Ready to work</h2>
        <span class="count">{{ board.counts.ready }}</span>
      </div>
      <p class="column-copy">No fix PR yet.</p>
      {% if board.ready.length %}
        {% for item in board.ready %}
          {% include "card.njk" %}
        {% endfor %}
      {% else %}
        <p class="empty">Nothing waiting for a PR.</p>
      {% endif %}
    </div>

    <div class="column">
      <div class="rule-head">
        <h2>In progress</h2>
        <span class="count">{{ board.counts.progress }}</span>
      </div>
      <p class="column-copy">A PR is open.</p>
      {% if board.progress.length %}
        {% for item in board.progress %}
          {% include "card.njk" %}
        {% endfor %}
      {% else %}
        <p class="empty">No open fix PRs on the board.</p>
      {% endif %}
    </div>

    <div class="column">
      <div class="rule-head">
        <h2>Recently resolved</h2>
        <span class="count">{{ board.counts.resolved }}</span>
      </div>
      <p class="column-copy">Fixed or merged. Ages off quickly.</p>
      {% if board.resolved.length %}
        {% for item in board.resolved %}
          {% include "card.njk" %}
        {% endfor %}
      {% else %}
        <p class="empty">No recently resolved items.</p>
      {% endif %}
    </div>
  </section>

  <footer class="site-foot">
    <p>Download, star, and fork counts are snapshots from the last admin update.</p>
    <p><a href="{{ site.repo }}/blob/main/src/_data/items.yaml">items.yaml</a> · <a href="{{ site.repo }}">source</a></p>
  </footer>
</body>
</html>
